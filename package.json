{
  "name": "resumd",
  "version": "0.1.0",
  "private": true,
  "description": "Keep a single Resume.md as the source of truth and sync it into CV builders",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cli": "bun src/cli/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "knip": "^6.48.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "bun@1.3.14"
}
