{
  "name": "resumd-cli",
  "version": "0.1.0",
  "description": "Keep a single Resume.md as the source of truth and sync it into CV builders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IskIvanov/ResuMD.git"
  },
  "bin": {
    "resumd": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {"node": ">=20"},
  "type": "module",
  "scripts": {
      "cli": "bun src/cli/index.ts",
      "demo": "vhs docs/demo.tape",
      "format": "biome check --write .",
      "format:check": "biome check .",
      "test": "vitest",
      "typecheck": "tsc --noEmit",
      "prepublish": "bun run typecheck && bunx vitest run && bun run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "knip": "^6.48.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.3.14"
}
