{
  "name": "resumd",
  "version": "0.1.0",
  "private": true,
  "description": "Keep a single Resume.md as the source of truth and sync it into CV builders",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cli": "bun src/cli/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "bun@1.3.14"
}
