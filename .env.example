# Optional. Connect (bun run cli connect-rx-resume, or pick it in the menu)
# saves these settings to ~/.config/resume-tools/.env, and every run reads
# them from there. Copy this file to .env only to override a saved setting
# when running from this folder; an empty value here never hides a saved one.
# .env is gitignored; never commit a real key.

# API key from your Reactive Resume account settings.
RXRESUME_API_KEY=

# Base URL of the Reactive Resume API. Change it for a self-hosted instance.
RXRESUME_API_URL=https://rxresu.me/api/openapi

# URL of the Reactive Resume web app, used to link to the builder.
RXRESUME_APP_URL=https://rxresu.me

# Set to 1 to log every Reactive Resume request (method, URL, status, time) to
# stderr. Also works per run: RXRESUME_DEBUG=1 bun run cli …
# RXRESUME_DEBUG=1
