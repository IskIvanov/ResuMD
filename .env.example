# Copy to .env and fill in. .env is gitignored; never commit a real key.

# API key from your Reactive Resume account settings.
RXRESUME_API_KEY=

# Base URL of the Reactive Resume API. Change it for a self-hosted instance.
RXRESUME_API_URL=https://rxresu.me/api/openapi

# URL of the Reactive Resume web app, used to link to the builder.
RXRESUME_APP_URL=https://rxresu.me
